{
  "name": "oh-my-pets",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "doctor:desktop": "node scripts/doctor.mjs",
    "dev": "tauri dev",
    "dev:web": "vite",
    "dev:web:e2e": "vite --mode browser-test --host 127.0.0.1 --port 1421 --strictPort",
    "build": "pnpm build:desktop",
    "build:desktop": "tauri build",
    "build:desktop:qa": "tauri build --bundles app",
    "build:web": "vue-tsc --noEmit && pnpm build:web:assets",
    "build:web:assets": "vite build",
    "test": "pnpm test:rust && pnpm test:web",
    "test:rust": "cargo test --workspace",
    "test:web": "vitest run",
    "test:e2e": "node scripts/run-playwright.mjs test",
    "test:e2e:install": "node scripts/run-playwright.mjs install",
    "test:e2e:update": "node scripts/run-playwright.mjs update",
    "coverage": "pnpm coverage:web && pnpm coverage:rust",
    "coverage:web": "vitest run --coverage && node scripts/check-coverage-report.mjs web",
    "coverage:rust": "node scripts/coverage-rust.mjs",
    "lint": "pnpm lint:rust && pnpm lint:web",
    "lint:rust": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings",
    "lint:web": "oxlint src/ui scripts tests/e2e vite.config.ts playwright.config.ts && vue-tsc --noEmit",
    "verify:core": "pnpm scope:check && pnpm test && pnpm test:e2e && pnpm lint && pnpm build:web:assets",
    "verify": "pnpm verify:core && pnpm build:desktop && pnpm closeout:check",
    "qa:desktop": "pnpm build:desktop:qa && node scripts/desktop-qa.mjs --manual",
    "qa:desktop:auto": "pnpm build:desktop && node scripts/desktop-qa.mjs --auto",
    "closeout:check": "node scripts/check-closeout.mjs",
    "scope:check": "node scripts/check-repository-scope.mjs",
    "scope:report": "node scripts/check-repository-scope.mjs --report",
    "format": "cargo fmt --all && prettier --write ."
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "pixi.js": "^8.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/coverage-v8": "3.2.7",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^30.0.0",
    "oxlint": "1.76.0",
    "prettier": "^3.0.0",
    "typescript": "^5.6.3",
    "vite": "^7.0.0",
    "vitest": "^3.0.0",
    "vue-tsc": "^3.0.0"
  },
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  }
}
