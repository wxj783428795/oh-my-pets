{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oh My Pets",
  "version": "0.1.0",
  "identifier": "com.ohmypets.preview",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "pet",
        "title": "卷卷",
        "url": "index.html?surface=pet",
        "width": 320,
        "height": 320,
        "minWidth": 320,
        "minHeight": 320,
        "maxWidth": 320,
        "maxHeight": 320,
        "center": true,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "visible": true,
        "focus": false,
        "focusable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.icns"]
  }
}
