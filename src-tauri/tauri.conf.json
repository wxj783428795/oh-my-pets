{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oh My Pets",
  "version": "0.1.0",
  "identifier": "com.ohmypets.preview",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Oh My Pets · macOS 预览版",
        "width": 820,
        "height": 680,
        "minWidth": 720,
        "minHeight": 600,
        "center": true,
        "transparent": true,
        "decorations": false,
        "shadow": true,
        "resizable": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": false
  }
}

